<launch>
	<!-- apm.launch with only the plugins the swarm uses (mavros_pluginlists.yaml next to
	     this file). run_swarm.sh: ros2 launch config/mavros_swarm.launch fcu_url:=... -->
	<arg name="fcu_url" default="udp://127.0.0.1:14555@" />
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="1" />
	<arg name="tgt_component" default="1" />
	<arg name="namespace" default=""/>
	<arg name="pluginlists_yaml" default="$(dirname)/mavros_pluginlists.yaml" />

	<include file="$(find-pkg-share mavros)/launch/node.launch">
		<arg name="pluginlists_yaml" value="$(var pluginlists_yaml)" />
		<arg name="config_yaml" value="$(find-pkg-share mavros)/launch/apm_config.yaml" />
		<arg name="fcu_url" value="$(var fcu_url)" />
		<arg name="gcs_url" value="$(var gcs_url)" />
		<arg name="tgt_system" value="$(var tgt_system)" />
		<arg name="tgt_component" value="$(var tgt_component)" />
		<arg name="fcu_protocol" value="v2.0" />
		<arg name="respawn_mavros" value="false" />
		<arg name="namespace" value="$(var namespace)"/>
	</include>
</launch>
